{
  "manifest_version": 3,
  "name": "GitHub Extension",
  "version": "0.4.0",
  "description": "Personal GitHub interface enhancements.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "features/hide-inbox-while-busy.js",
        "features/mute-users.js"
      ],
      "run_at": "document_start"
    }
  ]
}
