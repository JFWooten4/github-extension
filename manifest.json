{
  "manifest_version": 3,
  "name": "Fractured Github",
  "version": "0.6.0",
  "description": "Personal GitHub interface tweaks.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fractured Github",
    "default_icon": {
      "16": "icons/fractured-16.png",
      "32": "icons/fractured-32.png",
      "48": "icons/fractured-48.png",
      "128": "icons/fractured-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "features/hide-inbox-while-busy.js",
        "features/mute-users.js",
        "features/block-tooltips.js",
        "features/hide-contributing-guidelines-notice.js",
        "features/hide-footer.js",
        "features/organization-notifications.js",
        "features/relative-times.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/fractured-16.png",
    "32": "icons/fractured-32.png",
    "48": "icons/fractured-48.png",
    "128": "icons/fractured-128.png"
  }
}
